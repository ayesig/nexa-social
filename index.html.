
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Nexa Social</title>
<style>
*{box-sizing:border-box}
body{margin:0;font-family:Arial,sans-serif;background:#f1f3f8;color:#20243a}
header{background:#24205c;color:white;padding:20px;text-align:center}
header h1{margin:0}
main{max-width:600px;margin:20px auto;padding:12px}
.card{background:white;padding:18px;border-radius:14px;margin-bottom:15px;box-shadow:0 2px 8px #0001}
input,textarea{width:100%;padding:13px;margin:8px 0;border:1px solid #ddd;border-radius:8px}
button{background:#5145c7;color:white;border:0;padding:12px 18px;border-radius:8px;cursor:pointer}
.post{border-top:1px solid #eee;padding:12px 0}
footer{text-align:center;padding:20px;color:#777}
</style>
</head>
<body>
<header>
<h1>NEXA SOCIAL</h1>
<p>Connect • Share • Discover</p>
</header>
<main>
<div class="card">
<h2>Welcome to Nexa Social</h2>
<p>Your community. Your connections. Your voice.</p>
</div>
<div class="card">
<h3>Create a post</h3>
<input id="username" placeholder="Your name">
<textarea id="message" placeholder="What's happening?"></textarea>
<button onclick="publish()">Publish Post</button>
</div>
<div class="card">
<h3>Community Feed</h3>
<div id="feed">No posts yet. Be the first to share!</div>
</div>
</main>
<footer>© 2026 Nexa Social</footer>
<script>
function publish(){
const name=document.getElementById('username').value.trim();
const message=document.getElementById('message').value.trim();
if(!name||!message){alert('Enter your name and post first.');return;}
const post=document.createElement('div');
post.className='post';
const author=document.createElement('strong');
author.textContent=name;
const content=document.createElement('p');
content.textContent=message;
post.append(author,content);
const feed=document.getElementById('feed');
if(feed.textContent.includes('No posts yet'))feed.textContent='';
feed.prepend(post);
document.getElementById('message').value='';
}
</script>
</body>
</html>
